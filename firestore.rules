rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Profile of each Firebase Auth account. Passwords never live here:
    // Firebase Auth stores and verifies them.
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && validProfile();
      allow delete: if false;
    }

    // Projects live at the root so tasks from every project can be queried
    // together. `ownerId` says whose they are: rules aren't filters, so
    // every query must also filter on it or Firestore rejects it.
    match /projects/{projectId} {
      allow read, delete: if ownsExisting();
      allow create: if ownsIncoming() && validProject()
        && request.resource.data.createdAt == request.time;
      allow update: if ownsExisting() && ownsIncoming() && validProject()
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    // Tasks point at their project with `projectId`; it must be one of the
    // caller's projects, which may be created in the same batch.
    match /tasks/{taskId} {
      allow read, delete: if ownsExisting();
      allow create: if ownsIncoming() && validTask()
        && ownsProject(request.resource.data.projectId)
        && request.resource.data.createdAt == request.time;
      allow update: if ownsExisting() && ownsIncoming() && validTask()
        && request.resource.data.projectId == resource.data.projectId
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    // One document per payment, named `source_refId`: paying twice would be
    // an update, which nobody may do. The amounts repeat SeedlyDrops in
    // lib/models/seedly_drops.dart; change both together.
    match /drops/{dropId} {
      // A missing document reveals nothing, and the app reads one before
      // paying it for the first time.
      allow read: if resource == null || ownsExisting();
      allow create: if ownsIncoming() && validDrop(dropId);
      allow update: if false;
      // Only a task's drops come back, once it is unmarked or deleted.
      allow delete: if ownsExisting() && resource.data.source == 'task'
        && !taskDone(resource.data.refId);
    }

    // The server stamps the start, so nobody can invent when they began.
    match /sessions/{sessionId} {
      allow read: if ownsExisting();
      allow create: if ownsIncoming()
        && request.resource.data.keys().hasOnly(['ownerId', 'startedAt'])
        && request.resource.data.startedAt == request.time;
      allow update, delete: if false;
    }

    // The plant's phase. Rules can't add up drops, so the app checks there
    // are enough; here the phase only climbs one step at a time.
    match /progress/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && validProgress()
        && request.resource.data.phase == 1;
      allow update: if isOwner(uid) && validProgress()
        && request.resource.data.phase == resource.data.phase + 1;
      allow delete: if false;
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function ownsExisting() {
      return request.auth != null && resource.data.ownerId == request.auth.uid;
    }

    function ownsIncoming() {
      return request.auth != null
        && request.resource.data.ownerId == request.auth.uid;
    }

    // getAfter sees a project written earlier in the same batch.
    function ownsProject(projectId) {
      let project = getAfter(/databases/$(database)/documents/projects/$(projectId));
      return project != null && project.data.ownerId == request.auth.uid;
    }

    // getAfter, so a task marked done in the same batch counts.
    function taskDone(taskId) {
      let path = /databases/$(database)/documents/tasks/$(taskId);
      return existsAfter(path)
        && getAfter(path).data.ownerId == request.auth.uid
        && getAfter(path).data.done == true;
    }

    function projectComplete(projectId) {
      let path = /databases/$(database)/documents/projects/$(projectId);
      return existsAfter(path) && completeProject(getAfter(path).data);
    }

    function completeProject(project) {
      return project.ownerId == request.auth.uid
        && project.taskCount >= 3
        && project.doneCount == project.taskCount;
    }

    // No more minutes than have passed since the server stamped the start.
    function wateredLongEnough(sessionId, minutes) {
      let session = get(/databases/$(database)/documents/sessions/$(sessionId)).data;
      return session.ownerId == request.auth.uid
        && minutes * 60 <= (request.time - session.startedAt).seconds();
    }

    function validDrop(dropId) {
      let data = request.resource.data;
      return data.keys().hasOnly(['ownerId', 'source', 'refId', 'amount', 'createdAt'])
        && data.source is string && data.refId is string
        && dropId == data.source + '_' + data.refId
        && data.amount is int
        && data.createdAt == request.time
        && ((data.source == 'task' && data.amount == 3 && taskDone(data.refId))
            || (data.source == 'project' && data.amount == 10
                && projectComplete(data.refId))
            || (data.source == 'watering' && data.amount >= 1 && data.amount <= 120
                && wateredLongEnough(data.refId, data.amount)));
    }

    function validProgress() {
      let data = request.resource.data;
      return data.keys().hasOnly(['phase', 'updatedAt'])
        && data.phase is int && data.phase >= 1 && data.phase <= 4
        && data.updatedAt == request.time;
    }

    function validProfile() {
      let data = request.resource.data;
      return data.keys().hasOnly(
               ['email', 'displayName', 'photoUrl', 'providers', 'createdAt', 'lastSignInAt'])
        && data.email == request.auth.token.email
        && (data.displayName == null || data.displayName is string)
        && (data.photoUrl == null || data.photoUrl is string)
        && data.providers is list
        && data.createdAt is timestamp
        && data.lastSignInAt == request.time;
    }

    function validProject() {
      let data = request.resource.data;
      return data.keys().hasOnly(
               ['ownerId', 'name', 'description', 'icon', 'photo', 'kind', 'startDate',
                'endDate', 'taskCount', 'doneCount', 'createdAt'])
        // An avatar-sized JPEG; Firestore documents cap at 1 MiB.
        && (data.get('photo', null) == null
            || (data.photo is bytes && data.photo.size() <= 262144))
        && data.name is string && data.name.size() > 0 && data.name.size() <= 80
        && (data.description == null
            || (data.description is string && data.description.size() <= 500))
        && data.icon is string && data.icon.size() <= 32
        && data.kind in ['express', 'full']
        && (data.startDate == null || data.startDate is timestamp)
        && (data.endDate == null || data.endDate is timestamp)
        && (data.startDate == null || data.endDate == null
            || data.endDate >= data.startDate)
        && data.taskCount is int && data.doneCount is int
        && data.doneCount >= 0 && data.doneCount <= data.taskCount;
    }

    function validTask() {
      let data = request.resource.data;
      let dueDate = data.get('dueDate', null);
      let dueMinutes = data.get('dueMinutes', null);
      let reminder = data.get('reminderMinutes', null);
      return data.keys().hasOnly(
               ['ownerId', 'projectId', 'title', 'done', 'order', 'dueDate', 'dueMinutes',
                'reminderMinutes', 'createdAt'])
        && data.projectId is string
        && data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && data.done is bool
        && data.order is int && data.order >= 0
        && (dueDate == null || dueDate is timestamp)
        // A time of day needs a day, and a reminder needs that time.
        && (dueMinutes == null
            || (dueDate != null && dueMinutes is int
                && dueMinutes >= 0 && dueMinutes < 1440))
        && (reminder == null || (dueMinutes != null && reminder in [10, 30, 60]));
    }
  }
}
